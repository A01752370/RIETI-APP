<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="22sp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seguimiento"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_dark" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFolio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="#folio"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/tvEstatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estatus"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/purple_status"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Estado del reporte"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <!-- Timeline simple: fijo, cada renglón es un paso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView android:text="✔  Registrado — 18 Ago 2024, 10:00 AM" android:textColor="@color/text_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" />
            <TextView android:text="✔  En Revisión — 18 Ago 2024, 2:30 PM" android:textColor="@color/text_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" />
            <TextView android:text="✔  En Seguimiento — 18 Ago 2024, 2:30 PM" android:textColor="@color/text_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" />
            <TextView android:text="✔  Canalizado — 18 Ago 2024, 2:30 PM" android:textColor="@color/text_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" />
            <TextView android:text="✔  Concluido — 18 Ago 2024, 2:30 PM" android:textColor="@color/text_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" />
            <TextView android:text="○  Archivado — Falta de resolución física" android:textColor="@color/text_gray" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTituloComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Comentarios del Caso"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <!-- Vista de solo lectura (usuario) -->
        <TextView
            android:id="@+id/tvComentarioLectura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:background="@drawable/bg_card"
            android:text="Aquí la organización le deja saber al usuario por qué el estado del caso cambió."
            android:textColor="@color/teal_primary"
            android:textSize="13sp" />

        <!-- Vista editable (admin) -->
        <EditText
            android:id="@+id/etComentarioAdmin"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:background="@drawable/bg_input"
            android:hint="El administrador describe el estado del caso para que el usuario registrado pueda ver."
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAccion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Regresar"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_teal" />

    </LinearLayout>
</ScrollView>
