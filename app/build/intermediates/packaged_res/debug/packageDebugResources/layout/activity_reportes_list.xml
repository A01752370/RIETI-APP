<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenid@\nNombre"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="🔍  Buscar folios..."
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:enabled="false" />

            <!-- Contenedor donde se agregan las tarjetas de reporte por código -->
            <LinearLayout
                android:id="@+id/contenedorReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnHacerReporte"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="+ Hacer reporte"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button_teal" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/card_white">

        <TextView
            android:id="@+id/tabCasos"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📄  Casos"
            android:textColor="@color/teal_primary" />

        <TextView
            android:id="@+id/tabPerfil"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="👤  Perfil"
            android:textColor="@color/text_gray" />
    </LinearLayout>

</LinearLayout>
